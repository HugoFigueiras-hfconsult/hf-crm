{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.1.5/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('DAB_CONNSTRING')",
    "options": {
      "set-session-context": false
    }
  },
  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/api",
      "request-body-strict": true
    },
    "graphql": {
      "enabled": false
    },
    "mcp": {
      "enabled": true,
      "path": "/mcp",
      "allowed-hosts": [
        "mcp.hf-consult.de",
        "@env('DAB_CA_FQDN')"
      ],
      "dml-tools": {
        "describe-entities": true,
        "create-record": true,
        "read-records": true,
        "update-record": true,
        "delete-record": false,
        "execute-entity": false
      }
    },
    "host": {
      "mode": "production",
      "cors": {
        "origins": [],
        "allow-credentials": false
      },
      "authentication": {
        "provider": "EntraID",
        "jwt": {
          "audience": "@env('DAB_JWT_AUDIENCE')",
          "issuer": "@env('DAB_JWT_ISSUER')"
        }
      }
    }
  },
  "entities": {
    "Verbindungstest": {
      "source": {
        "object": "INFORMATION_SCHEMA.TABLES",
        "type": "view",
        "key-fields": ["TABLE_NAME"]
      },
      "permissions": [
        { "role": "authenticated", "actions": ["read"] }
      ]
    }
  }
}
